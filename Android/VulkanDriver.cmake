# Optional, pinned external checkout; no dependency download during normal builds.
set(OPENRUNE_ADRENOTOOLS_SOURCE "" CACHE PATH "libadrenotools source with submodules")
add_library(openrune_vulkan SHARED Android/VulkanDriver.cpp)
target_include_directories(openrune_vulkan PRIVATE SurrealGPU/include)
target_link_libraries(openrune_vulkan PRIVATE dl)
set_target_properties(openrune_vulkan PROPERTIES CXX_STANDARD 17)
if(OPENRUNE_ADRENOTOOLS_SOURCE)
    function(openrune_add_adrenotools)
        set(BUILD_SHARED_LIBS OFF)
        set(CMAKE_POSITION_INDEPENDENT_CODE ON)
        set(CMAKE_CXX_STANDARD 17)
        add_subdirectory("${OPENRUNE_ADRENOTOOLS_SOURCE}" "${CMAKE_BINARY_DIR}/adrenotools")
    endfunction()
    openrune_add_adrenotools()
    target_compile_definitions(openrune_vulkan PRIVATE OPENRUNE_ADRENOTOOLS)
    target_link_libraries(openrune_vulkan PRIVATE adrenotools)
    add_dependencies(openrune_vulkan main_hook hook_impl file_redirect_hook gsl_alloc_hook)
endif()
